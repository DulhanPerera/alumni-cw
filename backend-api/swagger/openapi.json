    "/api/profile/employment-history/{id}": {
      "put": {
        "tags": ["Profile"],
        "summary": "Update employment history",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
