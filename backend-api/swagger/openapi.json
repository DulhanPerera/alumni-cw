          }
        }
      }
    },
    "/api/keys/{id}/revoke": {
      "post": {
        "tags": ["API Keys"],
        "summary": "Revoke an API key",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked successfully"
          }
        }
      }
    },
    "/api/keys/usage-logs": {
      "get": {
        "tags": ["API Keys"],
        "summary": "Get API key usage logs",
        "responses": {
          "200": {
            "description": "API key usage logs fetched successfully"
          }
        }
      }
    },
    "/api/public/featured-today": {
      "get": {
        "tags": ["Public API"],
        "summary": "Get today's featured alumnus",
