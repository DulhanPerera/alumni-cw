    "/api/profile/certifications/{id}": {
      "put": {
        "tags": [
          "Profile"
        ],
        "summary": "Update a certification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CertificationRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certification updated successfully"
          }
        }
      },
      "delete": {
        "tags": [
          "Profile"
        ],
        "summary": "Delete a certification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
