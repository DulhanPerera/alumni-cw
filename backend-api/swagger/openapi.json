              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "License added successfully"
          }
        }
      }
    },
    "/api/profile/licenses/{id}": {
      "put": {
        "tags": ["Profile"],
        "summary": "Update a license",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LicenseRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "License updated successfully"
          }
        }
      },
      "delete": {
        "tags": ["Profile"],
        "summary": "Delete a license",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "License deleted successfully"
          }
        }
      }
    },
    "/api/profile/short-courses": {
      "post": {
        "tags": ["Profile"],
        "summary": "Add a short course",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ShortCourseRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Short course added successfully"
          }
        }
      }
    },
    "/api/profile/short-courses/{id}": {
      "put": {
        "tags": ["Profile"],
        "summary": "Update a short course",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
