    "/api/profile/upload-image": {
      "post": {
        "tags": ["Profile"],
        "summary": "Upload profile image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "profile_image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": ["profile_image"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile image uploaded successfully"
          }
        }
      }
    },
