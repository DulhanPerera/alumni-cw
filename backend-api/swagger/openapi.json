        "responses": {
          "200": {
            "description": "Bid status fetched successfully"
          }
        }
      }
    },
    "/api/bids/remaining-slots": {
      "get": {
        "tags": ["Bids"],
        "summary": "Get remaining monthly featured slots",
        "parameters": [
          {
            "name": "month",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "example": "2026-04"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Remaining monthly slots fetched successfully"
          }
        }
      }
    },
    "/api/bids/select-winner": {
