        "tags": [
          "Profile"
        ],
        "summary": "Upload profile image",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "profile_image": {
                    "type": "string",
                    "format": "binary"
                  }
                },
                "required": [
                  "profile_image"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Profile image uploaded successfully"
          }
        }
      }
    },
    "/api/bids": {
      "post": {
        "tags": [
          "Bids"
        ],
        "summary": "Place a blind bid",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BidCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Bid placed successfully"
          }
        }
      }
    },
    "/api/bids/{id}": {
      "put": {
        "tags": [
          "Bids"
        ],
        "summary": "Update a bid amount",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "example": 1
            }
          }
        ],
        "requestBody": {
